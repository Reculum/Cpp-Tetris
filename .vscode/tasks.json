{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "/usr/bin/g++-13",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "${fileDirname}/classe_griglia.cpp",
                "${fileDirname}/classe_matrice.cpp",
                "${fileDirname}/classe_tetramino.cpp",
                "${fileDirname}/funz_array.cpp",
                "${fileDirname}/funzioni_di_gioco.cpp",
                "-o",
                "tetris.exe",
                "-L/usr/lib/x86_64-linux-gnu",
                "-lncursesw"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}